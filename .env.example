DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tripclip

# Optional for Claude; without a key AI1 uses the rule-based fallback.
LLM_API_KEY=
LLM_BASE_URL=https://ai.cs.kookmin.ac.kr/v1
LLM_MODEL=claude-sonnet-4-5
# Optional: no key uses YouTube oEmbed.
YOUTUBE_API_KEY=
# Optional: empty uses mock places; configured uses Kakao Local (no silent fallback).
KAKAO_REST_API_KEY=

# Optional integration tests only; never point MYSQL_TEST_DB_NAME at an application DB.
RUN_MYSQL_INTEGRATION_TESTS=0
MYSQL_TEST_DB_NAME=tripclip_test
